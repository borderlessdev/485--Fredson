rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (isAdmin()
          && request.resource.data.keys().hasAll(['name', 'email', 'role'])
          && request.resource.data.role in ['admin', 'operator', 'collaborator'])
      );
      allow update: if signedIn() && (
        (isAdmin()
          && request.resource.data.role in ['admin', 'operator', 'collaborator'])
        ||
        (request.auth.uid == userId
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mustChangePassword', 'passwordChangedAt', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /app_meta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /cedentes/{cedenteId} {
      // resource == null: get em doc inexistente (necessário p/ sync precatório → cedente)
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'nome', 'statusEsteira']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /precatorios/{precatorioId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'status', 'form']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /precatorio_anexos/{precatorioId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.size <= 900000;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
